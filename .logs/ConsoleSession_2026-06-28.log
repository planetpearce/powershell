    [CmdletBinding()]
    param (
        [Parameter(Mandatory = $true, Position = 0)]
        [string]$SearchString,

        [Parameter(Mandatory = $false, Position = 1)]
        [string]$Extension = "*.*"
    )

    $currentDir = Get-Location

    Get-ChildItem -Recurse -Filter $Extension -File |
    Select-String -Pattern $SearchString |
    Select-Object
        @{Name = "File"; Expression = { Resolve-Path $_.Filename -Relative -RelativeBasePath $currentDir } } ,
        @{Name = "LineNumber"; Expression = { $_.LineNumber },
        @{Name = "Match"; Expression = { $_.Line.Trim() } }
    }

