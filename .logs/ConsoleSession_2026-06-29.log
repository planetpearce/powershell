    $xml = [xml](Get-Content $_.FullName -ErrorAction SilentlyContinue)
    
    # 1. Grab Core Attributes
    $sdk = $xml.Project.Sdk
    $outputType = $xml.Project.PropertyGroup.OutputType
    
    # Find any Azure Function package references
    $packages = $xml.Project.ItemGroup.PackageReference.Include
    $isFunctionApp = $packages -match "Microsoft\.Azure\.Functions" -or $packages -match "Microsoft\.NET\.Sdk\.Functions"

    # 2. Apply Classification Logic
    if ($sdk -like "*Web*") {
        $type = "Web App (ASP.NET Core)"
    }
    elseif ($isFunctionApp) {
        $type = "Azure Function App"
    }
    elseif ($outputType -eq "Exe") {
        $type = "Console / Executable Application"
    }
    else {
        $type = "Class Library"
    }

    # 3. Output standard summary object
    [PSCustomObject]@{
        "Project Name"  = $_.BaseName
        "Project Type"  = $type
        "Relative Path" = (Resolve-Path $_.FullName -Relative)
    }
