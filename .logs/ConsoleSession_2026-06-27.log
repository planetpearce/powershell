using System;
using System.Collections.Generic;
using System.Linq;
using System.Threading.Tasks;
using Bikini.Biz.Integration;
using Bikini.Core;
using Bikini.DataCore;
using Bikini.Shopify;
using Microsoft.EntityFrameworkCore;

namespace Bikini.Biz;

public class CommonOopsAdapter(DbContextCore dbCore, IChannelConfiguration channelConfiguration)
{
    private readonly List<string> _oopsOrderTags = ["FoundImage", "Wholesale"];

    public async Task<List<OrderCommonModel>> Orders(DateTime dateFrom, DateTime dateTo, int channelId)
    {
        var from = dateFrom.ToUniversalTime();
        var to = dateTo.ToUniversalTime();

        var channel = channelConfiguration.GetChannel(channelId);

        var orders = await dbCore.Orders
                                 .Include(o => o.SalesRep)
                                 .Include(o => o.Contact.Customer)
                                 .Where(o => o.OrderDate > from && o.OrderDate < to) // Removing OrderStatusEntries
                                 .ToListAsync();

        var models = orders.Select(order => OrderCommonModel(channel, order, new List<OrderItemCommonModel>()))
                           .ToList();
        return models;
    }

    public async Task<OrderCommonModel> Order(int channelId, int orderId)
    {
        var sw = System.Diagnostics.Stopwatch.StartNew();

        var channel = channelConfiguration.GetChannel(channelId);

        var justOrder = await dbCore.Orders
                                    .AsNoTracking()
                                    .Include(o => o.SalesRep)
                                    .Include(o => o.Contact.Customer)
                                    .Where(o => o.Id == orderId)
                                    .SingleAsync();

        var loadOrderMs = sw.ElapsedMilliseconds;

        var justItems = await dbCore.CartItems
                                    .AsNoTracking()
                                    .Include(ci => ci.Image.Category.Classification.Vendor)
                                    .Include(ci => ci.Product.ProductCode.ProductType)
                                    .Include(ci => ci.Product.ChannelProducts)
                                    .Include(ci => ci.Product.ProductEans)
                                    .Where(ci => ci.CartId == justOrder.CartId)
                                    .Select(ci => new
                                     {
                                         ci.Id,
                                         ci.Quantity,
                                         ci.Product,
                                         ci.Image,
                                         channelProduct = ci.Product.ChannelProducts.Single(cp => cp.ChannelId == channelId),
                                         productEan = ci.Product.ProductEans.SingleOrDefault(e => e.ImageId == ci.ImageId)
                                     })
                                    .ToListAsync();

        var loadCartItemsMs = sw.ElapsedMilliseconds - loadOrderMs;

        var artCodeEngine = new TemporaryArtCodeEngine();

        var model = OrderCommonModel(channel,
                                     justOrder,
                                     justItems
                                        .Select((item, i) => new OrderItemCommonModel
                                         {
                                             Id = (i + 1).ToString("D3"),
                                             Sku = SkuEngine.FromProductAndImage(channel.ChannelCode, item.Product, item.Image, item.channelProduct.PackSize, item.productEan),
                                             ArtCode = item.Image != null ? artCodeEngine.ArtCode(item.Image) : ArtCode.Invalid(),
                                             Caption = item.Image?.Caption,
                                             ProductTypeId = item.Product.ProductCode.ProductTypeId,
                                             Code = item.Product.ProductCode.Code,
                                             ProductCodeDescription = item.Product.ProductCode.Description,
                                             ProductType = item.Product.ProductCode.ProductType.DisplayName,
                                             ProductDetails = item.Product.Description,
                                             ProductFullName = $"{item.Product.ProductCode.ProductType.DisplayName} {item.Product.Description}",
                                             QuantityPerPack = item.channelProduct.PackSize,
                                             Quantity = item.Quantity * item.channelProduct.PackSize,
                                             ProductUnitPrice = item.channelProduct.Price,
                                             ProductUnitMsrp = item.channelProduct.Msrp,
                                             LineTotal = item.Quantity * item.channelProduct.Price,
                                             ProductionFileName = item.Product.ProductionFilename ?? "",
                                             ProductId = item.Product.Id,
                                             ProductionTypes = item.Product.ProductCode.ProductType.ProductionTypes,
                                             ImageId = item.Image?.Id,
                                             Packs = item.Quantity,
                                             ProductEan = item.productEan?.Ean ?? 0
                                         })
                                        .ToList());

        var buildModelMs = sw.ElapsedMilliseconds - loadOrderMs - loadCartItemsMs;

        System.Diagnostics.Debug.WriteLine($"      → Order query: {loadOrderMs}ms");
        System.Diagnostics.Debug.WriteLine($"      → CartItems query: {loadCartItemsMs}ms");
        System.Diagnostics.Debug.WriteLine($"      → Build model: {buildModelMs}ms");
        System.Diagnostics.Debug.WriteLine($"      → TOTAL CommonOopsAdapter.Order: {sw.ElapsedMilliseconds}ms");

        return model;
    }

